<mvc:View controllerName="com.demo.b78sapui5.controller.View4"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.ui.layout.form">
  <Page title="I am View4" showNavButton="true" navButtonPress="onNavBack">
    <content>
      <f:SimpleForm title="Employee Details" editable="true" layout="ResponsiveGridLayout" labelSpanL="2" labelSpanM="2" emptySpanL="6" emptySpanM="6">
        <f:content>
          <Label text="Employee Id"></Label>
          <Input id="oIpEmpId" value="{oModel>Empid}" enabled="false"></Input>
          <Label text="Name"></Label>
          <Input id="oIpName" value="{oModel>Name}"></Input>
          <Label text="Deisgnation"></Label>
          <Input id="oIpDesig" value="{oModel>Desig}"></Input>
          <Label text="Email"></Label>
          <Input id="oIpEmail" value="{oModel>Email}"></Input>
          <Label text="Status"></Label>
          <Input id="oIpStatus" value="{oModel>Status}"></Input>
          <Label text="Salary"></Label>
          <Input id="oIpSalary" value="{oModel>Salary}"></Input>
          <Label text="Rating"></Label>
          <Input id="oIpRating" value="{oModel>Rating}"></Input>
        </f:content>

      </f:SimpleForm>
      <Table items="{certUpdateModel>/results}">
      <headerToolbar>
          <Toolbar >
            <Title text="Add/Edit Certification Details"></Title>
            <ToolbarSpacer ></ToolbarSpacer>
            <Button icon="sap-icon://add" type="Emphasized" press="onPressAdd"></Button>
          </Toolbar>
        </headerToolbar>
        <columns>
          <Column >
            <Text text="Employee Id"></Text>
          </Column>
          <Column >
            <Text text="Certification Code"></Text>
          </Column>
          <Column >
            <Text text="Skill"></Text>
          </Column>
          <Column >
            <Text text="Description"></Text>
          </Column>
          <Column >
            <Text text="Delete"></Text>
          </Column>
        </columns>
        <items>
          <ColumnListItem >
            <Input value="{certUpdateModel>Empid}"></Input>
            <Input value="{certUpdateModel>Certcode}"></Input>
            <Input value="{certUpdateModel>Skill}"></Input>
            <Input value="{certUpdateModel>Certname}"></Input>
             <Button icon="sap-icon://delete" type="Reject" press="onDeleteRow"></Button>
          </ColumnListItem>
        </items>
      </Table>

    </content>
    <footer>
      <Bar >
        <contentRight>
          <Button text="Save" icon="sap-icon://save" press="onPresSave"></Button>
        </contentRight>
      </Bar>
    </footer>
  </Page>
</mvc:View>